<script>
    function setDelivery(id, value) {
        const data = {
            id: id,
            status: value,
        }
        fetch('setDelivery.php', {
            method: 'POST',
            body: JSON.stringify(data)
        }).then(response => response.text())
            .then(text => {
                console.log('yes')
                window.location.reload()
            })
            .catch(error => {
                console.error(error)
            })
    }


</script>
