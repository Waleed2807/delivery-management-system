<script>
     function handleSelection(value, id) {
            if (value === "delete") {
                if(confirm("Are you sure you wish to delete this record?")) {
                    window.location.href = 'deleteRecord.php?id=' + id;
                }
            } else if (value === 'update') {
                $('#updateModal').modal('show');
                fetchRecordData(id, false);
            } else if (value === 'assign') {
                $('#assignDelivererModal').modal('show');
                fetchRecordData(id, true)
            }
            document.getElementById('edit' + id).value = '';
        }

        function fetchRecordData(id, onlyId) {
            fetch('getRecord.php', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'id=' + id
            })
                .then(response => response.json())
                .then(data => {
                    if (onlyId === true) {
                        document.getElementById('id_deliverer').value = id;
                    } else {
                        document.getElementById('id_update').value = id;
                        document.getElementById('name_update').value = data.name;
                        document.getElementById('address_1_update').value = data.address_1;
                        document.getElementById('address_2_update').value = data.address_2;
                        document.getElementById('postcode_update').value = data.postcode;
                    }
                })
                .catch(error => console.error('Error:', error));
        }

        function updateDeliverer(value) {
            const data = {
                id: document.getElementById('id_deliverer').value,
                deliverer: value,
            }
            fetch('updateDeliverer.php', {
                method: 'POST',
                body: JSON.stringify(data)
            }).then(response => response.text())
                .then(text => {
                    $('#assignDelivererModal').modal('hide');
                    window.location.reload()
                })
                .catch(error => {
                    console.error(error)
                })
        }

        function updateRecord() {
            const data = {
                id: document.getElementById('id_update').value,
                name: document.getElementById('name_update').value,
                address_1: document.getElementById('address_1_update').value,
                address_2: document.getElementById('address_2_update').value,
                postcode: document.getElementById('postcode_update').value
            }
            fetch('updateRecord.php', {
                method: 'POST',
                body: JSON.stringify(data)
            }).then(response => response.text())
                .then(text => {
                    $('#updateModal').modal('hide');
                    window.location.reload()
                })
                .catch(error => {
                    console.error(error)
                })
        }
</script>
